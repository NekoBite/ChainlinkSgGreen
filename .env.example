# Copy this file to .env and fill in the two values. NEVER commit .env.

# Private key of a TESTNET-ONLY wallet holding some Sepolia ETH (no 0x prefix is fine either way)
CRE_ETH_PRIVATE_KEY=

# Anthropic API key for the AI trust score. Leave as "none" to run with an offline score.
LLM_API_KEY=none

# Optional: your own Sepolia RPC (Alchemy/Infura). Empty = public RPC.
SEPOLIA_RPC=
