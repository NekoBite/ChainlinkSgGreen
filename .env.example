# Copy this file to .env and fill in the two values. NEVER commit .env.

# Private key of a TESTNET-ONLY wallet holding some testnet gas (Base Sepolia ETH or Fuji AVAX) (no 0x prefix is fine either way)
CRE_ETH_PRIVATE_KEY=

# Anthropic API key for the AI trust score. Leave as "none" to run with an offline score.
LLM_API_KEY=none

# Chain: base (Base Sepolia, default) | fuji (Avalanche Fuji) | sepolia (Ethereum Sepolia)
CHAIN=base

# Optional: your own RPC URL for that chain. Empty = public RPC.
RPC_URL=

# Token for the operator's private SCADA feed; only the TEE handler uses it
OPERATOR_API_KEY=demo-operator-key
